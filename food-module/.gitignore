# =============================================================
# 食模块（food-module）独立仓库 .gitignore
# 说明：只提交源码、种子图与启动脚本，排除依赖/日志/运行时产物。
# =============================================================

# ---------- 依赖 ----------
node_modules/

# ---------- 构建产物 ----------
dist/
build/

# ---------- 日志 ----------
*.log
logs/
server/logs/

# ---------- 环境变量（保留 .env.example 模板） ----------
.env
.env.local
.env.*.local

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db

# ---------- 测试覆盖率 ----------
coverage/

# ---------- 运行时上传目录（保留 seeds 种子图） ----------
server/uploads/tmp/
server/uploads/2026*/

# ---------- 压缩包 / 临时文件 ----------
*.zip
*.tar.gz
*.rar
*.7z
.temp/
*.timestamp-*.mjs
