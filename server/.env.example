# 后端环境变量模板
# 复制此文件为 .env 并根据本地环境修改配置

# 应用配置
APP_KEYS=wudong-secret-key-2026
SERVER_PORT=7001

# 数据库配置（请根据本地环境修改）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=wudong

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT 密钥
JWT_SECRET=wudong-jwt-secret-2026

# 通义千问 API（可选，用于 AI 聊天功能）
QIANWEN_API_KEY=your_api_key_here
